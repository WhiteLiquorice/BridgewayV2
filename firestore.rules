rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is authenticated and not anonymous
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // ─── Orgs ───────────────────────────────────────────────────────────
    // Org documents: authenticated users can read their own org.
    // Only Cloud Functions (admin SDK) can create/update orgs.
    match /orgs/{orgId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only (Cloud Functions)
    }

    // ─── Profiles ───────────────────────────────────────────────────────
    // User profiles: users can read profiles in their org.
    // Creation/updates handled by Cloud Functions.
    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ─── Real-time Queue ────────────────────────────────────────────────
    // Queue entries need real-time client reads for the Dashboard.
    // Staff can read queue entries. Clients can create their own check-in.
    match /queue/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSignedIn();
    }

    // ─── Bookings (public-facing) ───────────────────────────────────────
    // The public booking page needs to create bookings without auth.
    // Reading bookings requires authentication.
    match /bookings/{bookingId} {
      allow create: if true; // Public booking form
      allow read: if isAuthenticated();
      allow update, delete: if isSignedIn();
    }

    // ─── Booking References (public upload metadata) ────────────────────
    match /booking_references/{refId} {
      allow read: if true; // Public — referenced from booking confirmation
      allow create: if true; // Created during public booking flow
      allow update, delete: if isSignedIn();
    }

    // ─── Widget Configs ─────────────────────────────────────────────────
    // Per-user dashboard widget layout preferences.
    match /widget_configs/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Notifications ──────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ── Analytics rollups: server-written, member-readable ───────────────
    match /clientMetrics/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false; // Cloud Functions only (Admin SDK bypasses rules)
    }

    match /serviceMetrics/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    match /staffMetrics/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    match /mrrHistory/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    match /serviceAffinity/{docId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    // ── Queue: members manage, clients read their own entry ─────────────
    match /queueEntries/{entryId} {
      allow read: if isOrgMember(resource.data.orgId)
                  || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow create, update: if isOrgMember(request.resource.data.orgId);
      allow delete: if false; // entries complete, never delete
    }

    // ── Campaigns: org members manage their own ─────────────────────────
    match /campaigns/{campaignId} {
      allow read, update, delete: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
    }

    match /campaignSends/{sendId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false; // trigger engine only
    }

    match /messageLogs/{logId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    // ── Segments ─────────────────────────────────────────────────────────
    match /clientSegments/{segmentId} {
      allow read, update, delete: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
    }

    // ── Feedback: written via callable, read by members ──────────────────
    match /feedback/{feedbackId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false; // submitFeedback callable validates + writes
    }

    // ── Gift cards: read by members; mutations via callables only ───────
    match /giftCards/{code} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false; // issue/redeem run in transactions server-side
    }

    match /giftCardTransactions/{txId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    // ── Expenses ─────────────────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false; // recordExpense callable validates + writes
    }

    // ── Integrations: members manage; secret never readable by client ───
    match /integrations/{integrationId} {
      allow read, update, delete: if isOrgMember(resource.data.orgId);
      allow create: if isOrgMember(request.resource.data.orgId);
    }

    match /webhookDeliveries/{deliveryId} {
      allow read: if isOrgMember(resource.data.orgId);
      allow write: if false;
    }

    // ── Ops logs: server only ─────────────────────────────────────────────
    match /functionLogs/{logId} {
      allow read, write: if false;
    }

    // ─── Default deny ───────────────────────────────────────────────────
    // Everything not matched above is denied by default.
    // Data Connect (server-side) bypasses these rules entirely.
  }
}
