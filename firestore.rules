rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is authenticated and not anonymous
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ─── Orgs ───────────────────────────────────────────────────────────
    // Org documents: authenticated users can read their own org.
    // Only Cloud Functions (admin SDK) can create/update orgs.
    match /orgs/{orgId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only (Cloud Functions)
    }

    // ─── Profiles ───────────────────────────────────────────────────────
    // User profiles: users can read profiles in their org.
    // Creation/updates handled by Cloud Functions.
    match /profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ─── Real-time Queue ────────────────────────────────────────────────
    // Queue entries need real-time client reads for the Dashboard.
    // Staff can read queue entries. Clients can create their own check-in.
    match /queue/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSignedIn();
    }

    // ─── Bookings (public-facing) ───────────────────────────────────────
    // The public booking page needs to create bookings without auth.
    // Reading bookings requires authentication.
    match /bookings/{bookingId} {
      allow create: if true; // Public booking form
      allow read: if isAuthenticated();
      allow update, delete: if isSignedIn();
    }

    // ─── Booking References (public upload metadata) ────────────────────
    match /booking_references/{refId} {
      allow read: if true; // Public — referenced from booking confirmation
      allow create: if true; // Created during public booking flow
      allow update, delete: if isSignedIn();
    }

    // ─── Widget Configs ─────────────────────────────────────────────────
    // Per-user dashboard widget layout preferences.
    match /widget_configs/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Notifications ──────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin SDK only
    }

    // ─── Default deny ───────────────────────────────────────────────────
    // Everything not matched above is denied by default.
    // Data Connect (server-side) bypasses these rules entirely.
  }
}
