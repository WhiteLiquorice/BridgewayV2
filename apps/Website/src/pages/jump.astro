---
import Base from '../layouts/Base.astro'
import JumpingShip from '../components/JumpingShip'
---

<Base
  title="Jumping Ship — Import Your Clients to Bridgeway"
  description="Migrating from Mindbody, Jane, or Boulevard? Drag and drop your roster sheet to map columns automatically."
  ogTitle="Jumping Ship — Import Your Clients to Bridgeway"
  ogDescription="Easily switch clinic management software with our automated drag-and-drop client roster mapper."
>
  <div className="bg-neutral-50 min-h-screen py-12 px-6 sm:px-12 lg:px-24">
    <div className="max-w-5xl mx-auto">
      {/* Header Back Button */}
      <div className="mb-8 flex items-center justify-between">
        <a href="/" className="flex items-center gap-2 text-sm text-neutral-500 hover:text-neutral-900 transition-colors">
          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Demo
        </a>
        <span className="text-[10px] text-neutral-400 font-semibold tracking-[0.2em] uppercase">Migration Tool</span>
      </div>

      <JumpingShip client:load />
    </div>
  </div>
</Base>
