---
import Base from '../layouts/Base.astro'
---

<Base title="Page Not Found — Bridgeway" description="The page you're looking for doesn't exist.">
  <div class="min-h-screen bg-white flex items-center justify-center">
    <div class="text-center max-w-md px-6">
      <p class="text-8xl font-serif text-neutral-100 mb-6">404</p>
      <h1 class="font-serif text-3xl text-neutral-900 tracking-tight mb-3">Page not found</h1>
      <p class="text-sm text-neutral-500 font-light leading-relaxed mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-block text-sm font-semibold text-white bg-neutral-900 rounded-xl px-6 py-3 hover:bg-neutral-800 transition-colors"
      >
        Back to Bridgeway
      </a>
    </div>
  </div>
</Base>
